# Browser runtime configuration
VITE_HIDRA_API_BASE_URL=http://localhost:8080
VITE_HIDRA_AUTH_MODE=basic
# Legacy basic mode selects one provider; multi mode requires an explicit deployment allowlist.
# To expose simultaneous credential and enterprise SSO options, set:
# VITE_HIDRA_AUTH_MODE=multi
# VITE_HIDRA_ENABLED_AUTH_PROVIDERS=LOCAL,LDAP,ACTIVE_DIRECTORY,OIDC
# OIDC additionally requires a registered redirect URI and properly configured HidraAPI/IdP.
# The allowlist is a display policy, not proof of provider health or access authorization.
VITE_HIDRA_CREDENTIAL_PROVIDER=LOCAL
# VITE_HIDRA_ENABLED_AUTH_PROVIDERS=LOCAL,LDAP,ACTIVE_DIRECTORY,OIDC
VITE_HIDRA_ENVIRONMENT=dev
VITE_HIDRA_DEFAULT_LOCALE=fr

# Enterprise OIDC redirect URI is a non-secret deployment/IdP registration input.
# In JWT mode it must exactly match an approved redirect URI registered at the external IdP.
VITE_HIDRA_OIDC_REDIRECT_URI=

# Authentication credentials/tokens are intentionally NOT build-time Vite variables.
# LOCAL/LDAP/Active Directory credentials are entered at runtime and kept in memory only.
# Enterprise OIDC access tokens are acquired at runtime and kept in memory only.

# Node-side OpenAPI generation configuration
HIDRA_OPENAPI_URL=http://localhost:8080/v3/api-docs
