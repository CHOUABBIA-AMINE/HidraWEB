server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Public TLS terminates at the approved ingress/edge before this internal listener.
    # The edge must redirect HTTP to HTTPS and forward only approved HTTPS traffic here.
    include /etc/nginx/snippets/hidra-security-headers.conf;

    # Exact STOMP/WebSocket transport path. This only forwards the HTTP Upgrade;
    # authentication semantics remain owned by HidraAPI and are not invented here.
    location = /api/v1/realtime/ws {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass ${HIDRA_API_UPSTREAM};
    }

    # SSE must not be buffered by the static/reverse-proxy tier.
    location = /api/v1/realtime/sse {
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass ${HIDRA_API_UPSTREAM};
    }

    # Preserve the complete HidraAPI path under the same browser origin.
    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass ${HIDRA_API_UPSTREAM};
    }

    # Vite fingerprinted assets are content-addressed and can be cached long-term.
    # Re-include the security headers because Nginx add_header inheritance stops when
    # this location defines its own Cache-Control header.
    location ^~ /assets/ {
        include /etc/nginx/snippets/hidra-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The application shell must revalidate so deployments pick up new asset hashes.
    location = /index.html {
        include /etc/nginx/snippets/hidra-security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # React Router history fallback for non-API browser routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
