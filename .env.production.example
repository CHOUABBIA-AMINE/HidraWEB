# HWEB-015-04 same-origin production deployment example.
# The browser reaches HidraAPI through the same public origin as HidraWEB.
VITE_HIDRA_API_BASE_URL=/
VITE_HIDRA_AUTH_MODE=jwt
VITE_HIDRA_ENVIRONMENT=production
VITE_HIDRA_DEFAULT_LOCALE=fr

# Required external IdP/deployment registration input.
# Example shape only; replace with the exact approved public origin.
VITE_HIDRA_OIDC_REDIRECT_URI=https://hidra.example.invalid/auth/callback

# Reverse-proxy CSP substitution. This must be the exact HTTPS origin of the
# approved enterprise IdP used by the backend-published OIDC contract.
# It is not a Vite/browser secret and is consumed only when rendering the Nginx template.
HIDRA_OIDC_ORIGIN=https://idp.example.invalid

# Node-side OpenAPI generation remains a build/CI concern and is not routed through the browser proxy.
HIDRA_OPENAPI_URL=http://localhost:8080/v3/api-docs
