{
  "name": "hidraweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hidra operational enterprise frontend for HidraAPI.",
  "engines": { "node": ">=24.0.0 <25" },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api:generate": "orval --config orval.config.ts",
    "api:generate:workbench": "orval --config orval.workbench.config.ts",
    "api:generate:identity-organization": "orval --config orval.identity-organization.config.ts",
    "api:generate:topology": "orval --config orval.topology.config.ts",
    "api:generate:telemetry-monitoring": "orval --config orval.telemetry-monitoring.config.ts",
    "api:generate:workflow": "orval --config orval.workflow.config.ts",
    "verify": "npm run api:generate:workbench && npm run api:generate:identity-organization && npm run api:generate:topology && npm run api:generate:telemetry-monitoring && npm run api:generate:workflow && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@tanstack/react-query": "5.102.8",
    "axios": "1.20.0",
    "echarts": "6.1.0",
    "i18next": "26.4.2",
    "maplibre-gl": "6.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-i18next": "17.0.11",
    "react-router": "8.3.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "orval": "8.30.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
