{
  "openapi": "3.0.3",
  "info": {
    "title": "HidraAPI topology map contract (source-pinned temporary snapshot)",
    "version": "e5385f0e1f8bb88b48c8e1368962ef72ec6922ae",
    "description": "Temporary HWEB-005 contract snapshot reconciled from HidraAPI main source at commit e5385f0e1f8bb88b48c8e1368962ef72ec6922ae. Retire when GAP-CONTRACT-001 provides a repository-published OpenAPI artifact."
  },
  "paths": {
    "/api/v1/topology/map/layers": {
      "get": {
        "operationId": "listTopologyLayers",
        "responses": {
          "200": {
            "description": "Published topology map layers",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/LayerDescriptor" } } } }
          }
        }
      }
    },
    "/api/v1/topology/map/layers/{layerId}": {
      "get": {
        "operationId": "getTopologyLayer",
        "parameters": [
          { "name": "layerId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Topology layer descriptor", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LayerDescriptor" } } } }
        }
      }
    },
    "/api/v1/topology/map/layers/{layerId}/features": {
      "get": {
        "operationId": "getTopologyLayerFeatures",
        "parameters": [
          { "name": "layerId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "format": "int32", "minimum": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 2000 } },
          { "name": "q", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Paged topology layer features", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeatureCollection" } } } }
        }
      }
    },
    "/api/v1/topology/map/geojson": {
      "get": {
        "operationId": "getTopologyGeoJson",
        "parameters": [
          { "name": "layers", "in": "query", "schema": { "type": "array", "items": { "type": "string" } }, "style": "form", "explode": true },
          { "name": "page", "in": "query", "schema": { "type": "integer", "format": "int32", "minimum": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 2000 } },
          { "name": "q", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Paged GeoJSON topology feature collection", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FeatureCollection" } } } }
        }
      }
    },
    "/api/v1/topology/map/search": {
      "get": {
        "operationId": "searchTopology",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "format": "int32", "minimum": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 2000 } }
        ],
        "responses": {
          "200": { "description": "Paged topology search result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SearchResult" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LayerDescriptor": {
        "type": "object",
        "required": ["id", "label", "geometryType", "description", "featuresEndpoint"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "geometryType": { "type": "string" },
          "description": { "type": "string" },
          "featuresEndpoint": { "type": "string" }
        }
      },
      "PointGeometry": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "enum": ["Point"] },
          "coordinates": { "type": "array", "items": { "type": "number" } }
        }
      },
      "LineStringGeometry": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "enum": ["LineString"] },
          "coordinates": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
        }
      },
      "MultiLineStringGeometry": {
        "type": "object",
        "required": ["type", "coordinates"],
        "properties": {
          "type": { "type": "string", "enum": ["MultiLineString"] },
          "coordinates": { "type": "array", "items": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } } }
        }
      },
      "Geometry": {
        "oneOf": [
          { "$ref": "#/components/schemas/PointGeometry" },
          { "$ref": "#/components/schemas/LineStringGeometry" },
          { "$ref": "#/components/schemas/MultiLineStringGeometry" }
        ],
        "discriminator": { "propertyName": "type" }
      },
      "FeatureProperties": {
        "type": "object",
        "required": ["layer", "entityType", "entityId"],
        "properties": {
          "layer": { "type": "string" },
          "entityType": { "type": "string" },
          "entityId": { "type": "string" },
          "code": { "type": "string", "nullable": true },
          "nameAr": { "type": "string", "nullable": true },
          "nameFr": { "type": "string", "nullable": true },
          "nameEn": { "type": "string", "nullable": true },
          "status": { "type": "string", "nullable": true },
          "facilityKind": { "type": "string", "nullable": true },
          "nodeType": { "type": "string", "nullable": true },
          "pipelineSystemId": { "type": "string", "nullable": true },
          "pipelineType": { "type": "string", "nullable": true },
          "fromNodeId": { "type": "string", "nullable": true },
          "toNodeId": { "type": "string", "nullable": true },
          "segmentType": { "type": "string", "nullable": true },
          "flowDirection": { "type": "string", "nullable": true },
          "connectionType": { "type": "string", "nullable": true }
        }
      },
      "Feature": {
        "type": "object",
        "required": ["type", "id", "geometry", "properties"],
        "properties": {
          "type": { "type": "string", "enum": ["Feature"] },
          "id": { "type": "string" },
          "geometry": { "$ref": "#/components/schemas/Geometry" },
          "properties": { "$ref": "#/components/schemas/FeatureProperties" }
        }
      },
      "FeatureCollection": {
        "type": "object",
        "required": ["type", "name", "page", "size", "totalFeatures", "totalPages", "hasNext", "layers", "features"],
        "properties": {
          "type": { "type": "string", "enum": ["FeatureCollection"] },
          "name": { "type": "string" },
          "layer": { "type": "string", "nullable": true },
          "page": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "totalFeatures": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" },
          "hasNext": { "type": "boolean" },
          "layers": { "type": "array", "items": { "type": "string" } },
          "features": { "type": "array", "items": { "$ref": "#/components/schemas/Feature" } }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": ["query", "type", "page", "size", "totalFeatures", "totalPages", "hasNext", "features"],
        "properties": {
          "query": { "type": "string" },
          "type": { "type": "string", "enum": ["FeatureCollection"] },
          "page": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "totalFeatures": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" },
          "hasNext": { "type": "boolean" },
          "features": { "type": "array", "items": { "$ref": "#/components/schemas/Feature" } }
        }
      }
    }
  }
}
